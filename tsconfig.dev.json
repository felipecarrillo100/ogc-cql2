{
  // The tests, the demo and the config files. The published sources are checked by tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "isolatedDeclarations": false,
    "declaration": false,
    // `vitest.config.ts` imports `vite.config.ts`.
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    // The demo and the tests import the package by its name, as a user does; this resolves it to the sources.
    // `vite.config.ts` aliases the same way, for Vite and Vitest.
    "paths": {
      "ogc-cql2": ["./src/index.ts"],
      "ogc-cql2/*": ["./src/*/index.ts"],
      // The playground's DuckDB worker: DuckDB-WASM's synchronous build, aliased the same way in vite.config.ts.
      "duckdb-wasm-blocking": ["./node_modules/@duckdb/duckdb-wasm/dist/duckdb-browser-blocking.d.ts"]
    }
  },
  "include": ["src", "test", "demo", "*.config.ts"]
}
