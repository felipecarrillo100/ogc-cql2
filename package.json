{
  "name": "ogc-cql2",
  "version": "0.1.0",
  "description": "OGC CQL2 1.0.0 (OGC 21-065r2) for JavaScript and TypeScript: validation, CQL2-text, in-memory evaluation and SQL (SQLite / GeoPackage, PostgreSQL / PostGIS) for CQL2-JSON filters, in browsers and Node.",
  "keywords": [
    "cql2",
    "cql2-json",
    "cql2-text",
    "ogc",
    "ogc-api",
    "ogc-api-features",
    "filter",
    "query",
    "sql",
    "sqlite",
    "geopackage",
    "postgresql",
    "postgis"
  ],
  "author": "Felipe Carrillo Romero",
  "homepage": "https://github.com/felipecarrillo100/ogc-cql2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipecarrillo100/ogc-cql2.git"
  },
  "bugs": {
    "url": "https://github.com/felipecarrillo100/ogc-cql2/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validate": {
      "types": "./dist/validate/index.d.ts",
      "import": "./dist/validate/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "import": "./dist/text/index.js"
    },
    "./evaluate": {
      "types": "./dist/evaluate/index.d.ts",
      "import": "./dist/evaluate/index.js"
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "import": "./dist/sql/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE-UNICODE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.dev.json",
    "test": "vitest run",
    "demo": "vite",
    "build:demo": "vite build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:imports && npm run check:bundle",
    "preview:demo": "vite preview",
    "check:imports": "node scripts/check-imports.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "publint": "^0.3.25",
    "tsdown": "~0.23.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
