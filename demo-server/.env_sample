# demo-server's database connections. Copy this file to .env (cp .env_sample .env) and fill in the ones you have;
# a database left empty is reported at start and its collections aren't served.
# PostgreSQL: its own environment variables, which the `pg` driver reads as they are.
# .env is git-ignored, so the password never reaches the repository; this sample, without values, is committed.
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Oracle Database 23ai or later (the oracledb driver, thin mode): host:port/service.
ORACLE_CONNECT=
ORACLE_USER=
ORACLE_PASSWORD=
# SQL Server 2022 or later (the mssql driver). MSSQL_ENCRYPT=false for a server without TLS.
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=
