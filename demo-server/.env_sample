# demo-server's PostgreSQL connection. Copy this file to .env (cp .env_sample .env) and fill it in.
# The names are PostgreSQL's own environment variables, which the `pg` driver reads as they are.
# .env is git-ignored, so the password never reaches the repository; this sample, without values, is committed.
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
