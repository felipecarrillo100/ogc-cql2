{
  "collections": [
    { "id": "states", "title": "US states", "source": "geojson", "file": "data/states.geojson" },
    { "id": "kitchen_sink", "title": "Kitchen sink", "source": "geojson", "file": "data/kitchen_sink.geojson" },
    { "id": "parquet-states", "title": "US states", "source": "geoparquet", "file": "data/states.parquet" },
    { "id": "parquet-kitchen_sink", "title": "Kitchen sink", "source": "geoparquet", "file": "data/kitchen_sink.parquet" },
    { "source": "geopackage", "file": "data/usa.gpkg", "prefix": "gpkg-" },
    {
      "source": "postgres",
      "prefix": "pg-",
      "functionSchema": "cql2demo",
      "tables": [
        { "table": "cql2demo.states", "title": "US states" },
        { "table": "cql2demo.sub_regions", "title": "Census sub-regions" },
        { "table": "cql2demo.kitchen_sink", "title": "Kitchen sink" },
        { "table": "cql2demo.kitchen_sink_3857", "title": "Kitchen sink (Web Mercator)" }
      ]
    },
    { "source": "oracle", "prefix": "ora-", "tables": [{ "table": "STATES", "title": "US states" }, { "table": "KITCHEN_SINK", "title": "Kitchen sink", "days": ["day"] }] },
    { "source": "sqlserver", "prefix": "ms-", "tables": [{ "table": "dbo.states", "title": "US states" }, { "table": "dbo.kitchen_sink", "title": "Kitchen sink" }] }
  ]
}
